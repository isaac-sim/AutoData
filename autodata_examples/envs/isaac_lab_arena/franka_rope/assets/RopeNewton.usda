(
    defaultPrim = "World"
)

# Keep the shared simulation topology, round visual mesh, and material.
# Newton uses the simulation tetrahedra directly; the PhysX collision mesh is redundant.
def Xform "World" (
    prepend references = @Rope.usd@
)
{
    over "collision_mesh" (
        active = false
    )
    {
    }
}
