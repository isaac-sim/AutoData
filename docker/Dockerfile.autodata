ARG BASE_IMAGE=nvcr.io/nvidia/isaac-sim:6.1.0
FROM ${BASE_IMAGE}

USER root

ARG WORKDIR=/workspaces/autodata
ENV WORKDIR=${WORKDIR}
WORKDIR "${WORKDIR}"

ARG UV_VERSION=0.12.21
ENV TERM=xterm \
    UV_HTTP_TIMEOUT=120 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/autodata/.venv \
    UV_PYTHON_INSTALL_DIR=/opt/autodata/python \
    VIRTUAL_ENV=/opt/autodata/.venv \
    CUDA_HOME=/usr/local/cuda-12.8
ENV ISAACLAB_PATH=${WORKDIR}/submodules/IsaacLab-Arena/submodules/IsaacLab \
    PATH=${VIRTUAL_ENV}/bin:${CUDA_HOME}/bin:${PATH}

# Hide conflicting Vulkan files, if needed.
RUN if [ -e "/usr/share/vulkan" ] && [ -e "/etc/vulkan" ]; then \
      mv /usr/share/vulkan /usr/share/vulkan_hidden; \
    fi

# Install apt packages
RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      git-lfs \
      openssh-client \
      ripgrep \
      cmake \
      build-essential \
      sudo \
      jq \
      ffmpeg \
      curl \
      ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" \
    | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh

# Install the locked dependencies before application sources to preserve build caching.
COPY pyproject.toml uv.lock ${WORKDIR}/
COPY submodules/IsaacLab-Arena ${WORKDIR}/submodules/IsaacLab-Arena
# Kit writes beneath its installation; set permissions in the layer that creates each file.
RUN --mount=type=cache,id=autodata-uv,target=/root/.cache/uv,sharing=locked \
    uv sync --locked --no-install-project \
    && find /opt/autodata ! -type l ! -group isaac-sim \
      -exec chgrp isaac-sim {} + -exec chmod g+rwX {} +

#####################
# cuRobo (optional)
#####################
ARG INSTALL_CUROBO=false
# Default arch list, run_docker.sh overrides it with the detected compute capability.
ARG TORCH_CUDA_ARCH_LIST=8.0+PTX
# Limit concurrent compiler processes on shared GPU hosts.
ARG MAX_JOBS=4

ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}
COPY docker/setup/install_cuda.sh /tmp/install_cuda.sh
RUN --mount=type=cache,id=autodata-uv,target=/root/.cache/uv,sharing=locked \
    set -e; if [ "$INSTALL_CUROBO" = "true" ]; then \
      /tmp/install_cuda.sh; \
      uv cache clean nvidia-curobo; \
      uv sync --locked --no-install-project --group curobo; \
      find /opt/autodata ! -type l ! -group isaac-sim \
        -exec chgrp isaac-sim {} + -exec chmod g+rwX {} +; \
    fi; rm -f /tmp/install_cuda.sh

##################
# AutoData
##################
# Keep application changes after cuRobo so they do not rebuild its CUDA kernels.
COPY README.md sitecustomize.py ${WORKDIR}/
COPY autodata_core ${WORKDIR}/autodata_core
COPY autodata_interfaces ${WORKDIR}/autodata_interfaces
COPY autodata_metrics ${WORKDIR}/autodata_metrics
COPY autodata_retargeting ${WORKDIR}/autodata_retargeting
COPY autodata_utils ${WORKDIR}/autodata_utils
COPY autodata_examples ${WORKDIR}/autodata_examples
COPY autodata_tests ${WORKDIR}/autodata_tests
RUN --mount=type=cache,id=autodata-uv,target=/root/.cache/uv,sharing=locked \
    set -e; if [ "$INSTALL_CUROBO" = "true" ]; then \
      uv sync --locked --group curobo; \
    else \
      uv sync --locked; \
    fi; \
    find /opt/autodata ! -type l ! -group isaac-sim \
      -exec chgrp isaac-sim {} + -exec chmod g+rwX {} +

# Set aliases for the shell
RUN echo 'export VIRTUAL_ENV=/opt/autodata/.venv' >> /etc/bash.bashrc \
 && echo 'export PATH="${VIRTUAL_ENV}/bin:${CUDA_HOME}/bin:${PATH}"' >> /etc/bash.bashrc \
 && echo "alias pip3='uv pip'" >> /etc/bash.bashrc \
 && echo "alias ll='ls -alF --color=auto'" >> /etc/bash.bashrc \
 && echo "PS1='[AutoData] \[\e[0;32m\]\u \[\e[0;34m\]\w\[\e[0m\] \$ '" >> /etc/bash.bashrc \
 && cp /etc/bash.bashrc /root/.bashrc

# Set the entrypoint
COPY docker/setup/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
# Host bytecode can contain source paths that are unavailable in the container.
ENV PYTHONPYCACHEPREFIX=/tmp/autodata-pycache
ENTRYPOINT ["/entrypoint.sh"]
HEALTHCHECK NONE
